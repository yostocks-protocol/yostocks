---
import { pillars } from '../data/content'

// Lucide-style outline icons (hand tap, clock, shield check).
const icons = {
  tap: '<path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10"/><path d="M12 10V8.5a1.5 1.5 0 0 1 3 0V11"/><path d="M15 10.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-.5a6 6 0 0 1-4.9-2.5L4.3 15.3a1.5 1.5 0 0 1 2.3-1.9L9 15.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
}
---
<section class="block" id="why">
  <p class="kicker">Why yostocks</p>
  <h2>Investing that fits <strong>in a chat</strong></h2>
  <div class="glow-grid">
    {pillars.map((p, i) => (
      <div class="glow-card reveal" style={`--glow: ${p.glow}; --delay: ${0.1 * (i + 1)}s`}>
        <div class="glow-halo" aria-hidden="true"></div>
        <div class="glow-face">
          <svg class="glow-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon]} />
          <div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
