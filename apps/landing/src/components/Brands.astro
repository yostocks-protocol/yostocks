---
import { brands } from '../data/content'

const icon: Record<(typeof brands)[number], string> = {
  'BNB Chain': '<path fill="currentColor" stroke="none" d="M12 2l3 3-3 3-3-3zM5 9l3 3-3 3-3-3zm14 0l3 3-3 3-3-3zm-7 0l3 3-3 3-3-3zm0 7l3 3-3 3-3-3z"/>',
  'Agentic Wallet': '<rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 12.5h2"/><path d="M6 6V5a2 2 0 0 1 2-2h8"/>',
  bStocks: '<path d="M4 18l5-6 4 3 7-9"/>',
  Ondo: '<circle cx="12" cy="12" r="8"/>',
  xStocks: '<path d="M6 6l12 12M18 6L6 18"/>',
  'Agent Studio': '<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M9 12h6M12 9v6"/>',
}
---
<div class="brands" aria-label="Built on">
  <span class="label">Built on</span>
  {brands.map((b) => (
    <span class="brand-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={icon[b]} />
      {b}
    </span>
  ))}
</div>
